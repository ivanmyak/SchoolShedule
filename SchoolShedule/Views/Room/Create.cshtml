@model RoomCreateViewModel

@{
    ViewData["Title"] = "Create Room";
}
<h2>Добавление нового кабинета для проведения уроков</h2>

<link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />

<form asp-action="Create" method="post" class="border p-4 rounded shadow-sm bg-light">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- Этаж -->
    <div class="col-md-3">
        <label asp-for="Floor" class="form-label"></label>
        <input asp-for="Floor" class="form-control" />
        <span asp-validation-for="Floor" class="text-danger"></span>
    </div>

    <!-- Номер кабинета -->
    <div class="col-md-3">
        <label asp-for="Number" class="form-label"></label>
        <input asp-for="Number" class="form-control" />
        <span asp-validation-for="Number" class="text-danger"></span>
    </div>

    <!-- Предметы -->
    <div class="mb-3">
        <label class="form-label">Основные предметы</label>
        <select asp-for="SelectedSubjectIds" class="form-select subject-select" multiple>
            @foreach (var s in Model.Subjects)
            {
                <option value="@s.Id">@s.Name</option>
            }
        </select>
        <span asp-validation-for="SelectedSubjectIds" class="text-danger"></span>
    </div>

    <button class="btn btn-primary">Создать</button>
    <a asp-action="All" class="btn btn-secondary">Обратно к списку</a>
</form>

@section Scripts {
    <script src="~/lib/select2/js/select2.min.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(".subject-select").select2({ width: '100%' });
    </script>

}
