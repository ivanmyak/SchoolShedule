@model SchoolShedule.Entities.Room

@{
    ViewData["Title"] = "Delete Room";
}

<h1 class="text-danger">Удаление кабинета</h1>

<h3 class="text-warning">Вы уверены, что желаете удалить данный кабинет?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Floor)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Floor)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Number)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Number)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" /> |
        <a asp-action="All" class="btn btn-secondary">Обратно к списку</a>

    </form>
</div>
