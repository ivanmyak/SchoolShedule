@model TeacherUpdateViewModel

@{
    ViewData["Title"] = "Edit Teacher";
}
<h2 class="mb-4">Редактирование преподавателя</h2>

<link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />

<form asp-action="Edit" method="post" class="border p-4 rounded shadow-sm bg-light">

    <input type="hidden" asp-for="Id" />

    <!-- ФИО -->
    <div class="row mb-3">
        <div class="col-md-4">
            <label asp-for="LastName" class="form-label"></label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="FirstName" class="form-label"></label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="MiddleName" class="form-label"></label>
            <input asp-for="MiddleName" class="form-control" />
            <span asp-validation-for="MiddleName" class="text-danger"></span>
        </div>
    </div>

    <!-- Email -->
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <!-- Предметы -->
    <div class="mb-3">
        <label asp-for="SelectedSubjectIds" class="form-label"></label>
        <select asp-for="SelectedSubjectIds" class="form-select subject-select" multiple>
            @foreach (var s in Model.Subjects)
            {
                <option value="@s.Id" selected="@(Model.SelectedSubjectIds.Contains(s.Id))">
                    @s.Name
                </option>
            }
        </select>
        <span asp-validation-for="SelectedSubjectIds" class="text-danger"></span>
    </div>

    <button class="btn btn-primary">Сохранить</button>
    <a asp-action="All" class="btn btn-secondary">Обратно к списку</a>
</form>

<form asp-controller="Account" asp-action="ResetPasswordByAdmin" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-warning">Сбросить пароль данному учителю!</button>
</form>

@section Scripts {
    <script src="~/lib/select2/js/select2.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(".subject-select").select2({
            width: '100%',
            placeholder: "Выберите предметы"
        });
    </script>
}
