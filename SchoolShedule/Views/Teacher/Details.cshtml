@model Teacher

@{
    ViewData["Title"] = "Details Teacher";
}
<h2 class="mb-4">Информация о преподавателе</h2>

<div class="card shadow-sm">
    <div class="card-body">

        <h4 class="card-title">@Model.User.GetFIO</h4>
        <p class="text-muted">@Model.User.Email</p>

        <hr />

        <dl class="row">

            <dt class="col-sm-3">Фамилия</dt>
            <dd class="col-sm-9">@Model.User.LastName</dd>

            <dt class="col-sm-3">Имя</dt>
            <dd class="col-sm-9">@Model.User.FirstName</dd>

            <dt class="col-sm-3">Отчество</dt>
            <dd class="col-sm-9">@Model.User.MiddleName</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.User.Email</dd>

            <dt class="col-sm-3">Предметы</dt>
            <dd class="col-sm-9">@Model.SubjectsToString</dd>

            <dt class="col-sm-3">Дата регистрации</dt>
            <dd class="col-sm-9">@Model.User.RegisteredAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>

        </dl>

        <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-primary">Редактировать</a>
        <a asp-action="All" class="btn btn-secondary">Обратно к списку</a>


    </div>
</div>
