<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SchoolShedule</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SchoolShedule.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Расписание</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Shedule" asp-action="All">Расписание на полугодие</a>
                            </li>

                            @if (User.IsInRole("Administrator"))
                            {
                                <li class="nav-item">
                                    <details class="nav-details">
                                        <summary class="nav-link text-dark">Управление</summary>
                                        <ul class="dropdown-list">
                                            <li><a class="dropdown-item" asp-controller="ClassGroup" asp-action="All">Классы</a></li>
                                            <li><a class="dropdown-item" asp-controller="Teacher" asp-action="All">Учителя</a></li>
                                            <li><a class="dropdown-item" asp-controller="Subject" asp-action="All">Предметы</a></li>
                                            <li><a class="dropdown-item" asp-controller="Room" asp-action="All">Кабинеты</a></li>
                                            <li><a class="dropdown-item" asp-controller="TimeSlot" asp-action="All">Временные слоты</a></li>
                                            <li><a class="dropdown-item" asp-controller="Lesson" asp-action="All">Уроки</a></li>
                                            <li><a class="dropdown-item" asp-controller="Shedule" asp-action="All">Расписания</a></li>
                                        </ul>
                                    </details>
                                </li>
                            }

                        }
                    </ul>
                    <ul class="navbar-nav d-flex">
                        @if (User.IsInRole("Administrator"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-area="" asp-controller="Account" asp-action="initdb">Initialize</a>
                            </li>
                        }
                        <li class="nav-item">
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-warning text-dark" title="Выход из системы">Выход</button>
                                </form>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-success" title="Выполнить вход в систему">Вход</a>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            @* &copy; 2026 - SchoolShedule - *@
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
