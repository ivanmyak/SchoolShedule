@model SchoolShedule.Entities.TimeSlot

@{
    ViewData["Title"] = "Delete TimeSlot";
}

<h1 class="text-danger">Удалить учебное занятие</h1>

<h3 class="text-warning">Вы уверены, что желаете ужалить данное занятие?</h3>
<div>
    <h4>TimeSlot</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DayOfWeek)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DayOfWeek)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Period)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Period)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" /> |
        <a asp-action="All" class="btn btn-secondary">Обратно к списку</a>

    </form>
</div>
