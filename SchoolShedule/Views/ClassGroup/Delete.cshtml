@model SchoolShedule.Entities.ClassGroup

@{
    ViewData["Title"] = "Delete ClassGroup";
}


<h1 class="text-danger">Удаление группы учащихся</h1>

<h3 class="text-warning">Вы действительно желаете удалить данную группу учащихся?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Letter)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Letter)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Grade)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Grade)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" /> |
        <a asp-action="All" class="btn btn-secondary">Обратно к списку</a>

    </form>
</div>
