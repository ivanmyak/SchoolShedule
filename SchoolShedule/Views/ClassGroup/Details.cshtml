@model SchoolShedule.Entities.ClassGroup

@{
    ViewData["Title"] = "Details ClassGroup";
}

<div>
    <h4>Группа</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Letter)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Letter)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Grade)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Grade)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Изменить</a> |
    <a asp-action="All" class="btn btn-secondary">Обратно к списку</a>

</div>
