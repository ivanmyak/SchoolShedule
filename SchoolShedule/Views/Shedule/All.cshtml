@model AllSchedulesViewModel
@using SchoolShedule.Enums
@using SchoolShedule.Extensions

@{

    var days = Enum.GetValues(typeof(Day)).Cast<Day>().ToList();
    int maxPeriods = 8; // взятое с головы максимальное количество уроков
    int modalCounter = 0; // уникальные id для модальных окон
}

<h2 class="mb-4 text-center">📚 Расписание на полугодие</h2>

<div class="d-flex justify-content-center mb-4">
    <form method="get" asp-action="All" class="w-auto">
        <select name="groupType" asp-for="SelectedGroupType"
                asp-items="Html.GetEnumSelectList<GroupType>()"
                class="form-select text-center"
                onchange="this.form.submit()">
        </select>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-bordered text-center align-middle shadow-sm">
        <thead class="table-primary">
            <tr>
                <th style="width: 80px;">Урок</th>
                @foreach (var day in days)
                {
                    <th>@day.GetDisplayName()</th>
                }
            </tr>
        </thead>
        <tbody>
            @for (int period = 1; period <= maxPeriods; period++)
            {
                <tr>
                    <td class="fw-bold bg-light">@period</td>
                    @foreach (var day in days)
                    {
                        var lessons = Model.Lessons
                        .Where(l => l.TimeSlot.DayOfWeek == day && l.TimeSlot.Period == period)
                        .OrderBy(l => l.ClassGroup.Grade)
                        .ThenBy(l => l.ClassGroup.Letter)
                        .ToList();

                        <td>
                            @if (lessons.Any())
                            {
                                foreach (var lesson in lessons)
                                {
                                    bool isOwnSubject = lesson.Teacher.Subjects.Any(s => s.Code == lesson.Subject.Code);

                                    var teacherShort = lesson.Teacher.GetFIO;

                                    var specialization = lesson.Teacher.SubjectsToString;
                                    var modalId = $"modal_{modalCounter++}";
                                    var modalLabelId = $"{modalId}_Label";

                                    <div class="card mb-2 shadow-sm @(isOwnSubject ? "" : "bg-warning") position-relative">
                                        <div class="card-body p-2">
                                            <div class="fw-bold d-flex justify-content-between align-items-start">
                                                @lesson.Subject.Name
                                                @if (!isOwnSubject)
                                                {
                                                    <button type="button" class="btn btn-sm btn-link p-0 text-dark"
                                                            data-bs-toggle="modal" data-bs-target="#@modalId"
                                                            title="Подробнее">
                                                        ❓
                                                    </button>
                                                }
                                            </div>
                                            <small>
                                                @teacherShort<br />
                                                Класс: @lesson.ClassGroup.Name<br />
                                                Кабинет: @lesson.Room.RoomNumber
                                            </small>
                                        </div>
                                    </div>

                                    @if (!isOwnSubject)
                                    {
                                        <!-- Модальное окно -->
                                        <div class="modal fade" id="@modalId" tabindex="-1" aria-labelledby="@modalLabelId" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered">
                                                <div class="modal-content">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title" id="@modalLabelId">Специализация преподавателя</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p><strong>@lesson.Teacher.User.LastName @lesson.Teacher.User.FirstName @lesson.Teacher.User.MiddleName</strong></p>
                                                        <p>Основные предметы: @specialization</p>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
