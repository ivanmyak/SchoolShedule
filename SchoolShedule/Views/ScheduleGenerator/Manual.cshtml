@model List<ManualGenerateViewModel>
@using SchoolShedule.Extensions

@{
    ViewData["Title"] = "Ручное составление расписания";

    int index = ViewBag.Index ?? 0;
    var current = Model[index];

    var slotsPerDay = current.CalculatedTimeSlots
        .GroupBy(ts => ts.DayOfWeek);
}

<div class="container-fluid mt-3">
    <h1 class="text-center mb-4">
        Расписание для класса @current.ClassGroup.Name
        <small class="text-muted">(@current.SelectedSchedulePeriod.GetDisplayName())</small>
    </h1>

    <div class="row">
        <div class="col-3">
            <h4>Предметы и часы</h4>
            <ul id="subjects-list" class="list-group">
                @foreach (var (subjectId, hours) in current.SubjectHours)
                {
                    var subject = current.Subjects.First(s => s.Id == subjectId);

                    <li class="list-group-item d-flex justify-content-between align-items-center subject-item"
                        draggable="true"
                        data-subject-id="@subject.Id"
                        data-subject-name="@subject.Name"
                        data-hours="@hours">

                        <span>@subject.Name</span>
                        <span class="badge bg-primary rounded-pill">@hours</span>
                    </li>
                }
            </ul>
        </div>

        <div class="col-9">
            <h4 class="mb-3">Таблица расписания</h4>

            <table class="table table-bordered text-center align-middle" id="schedule-table">
                <thead>
                    <tr>
                        <th>Урок</th>
                        @foreach (var day in Enum.GetValues<SchoolShedule.Enums.Day>())
                        {
                            <th>@day.GetDisplayName()</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < slotsPerDay.Max(spd => spd.Count()); i++)
                    {
                        <tr>
                            <td><strong>@(i + 1).</strong></td>

                            @foreach (var day in Enum.GetValues<SchoolShedule.Enums.Day>())
                            {
                                var slot = current.CalculatedTimeSlots
                                    .FirstOrDefault(cts => cts.Period == (i + 1) && cts.DayOfWeek == day);

                                if (slot is not null)
                                {
                                    <td class="schedule-cell"
                                        data-day="@day"
                                        data-period="@slot.Period"
                                        id="@slot.Id">
                                        <div class="cell-content dropzone"></div>
                                    </td>
                                }
                                else
                                {
                                    <td class="bg-light text-muted">—</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="teacherModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Выбор преподавателя</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <select id="teacher-select" class="teacher-select">
                    @foreach (var teacher in current.Teachers)
                    {
                        var text = $"{teacher.User.GetFIO} ({teacher.SubjectsToString})";

                        <option value="@teacher.UserId"
                                data-subjects="@string.Join(",", teacher.Subjects.Select(s => s.Id))">
                            @text
                        </option>
                    }
                </select>
            </div>

            <div class="modal-footer">
                <button class="btn btn-primary" id="teacher-select-confirm">Выбрать</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/select2/js/select2.min.js"></script>

    <script>
        $(function () {
            $('#teacher-select').select2({
                width: '100%',
                templateResult: highlightTeachers,
                templateSelection: highlightTeachers,
                sorter: teacherSorter
            });
        });
    </script>

    <script src="~/js/manual-schedule.js"></script>
}
