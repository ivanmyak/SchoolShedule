@model List<ManualGenerateViewModel>
@using SchoolShedule.Extensions

@{
    ViewData["Title"] = "Ручное составление расписания";

    int currentIndex = ViewBag.Index ?? 0;
    int lastIndex = Model.Count - 1;
}

<link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />

<div class="container-fluid mt-4">

    <!-- Навигация между классами -->
    <div class="d-flex justify-content-center align-items-center mb-4">

        <!-- Левая стрелка -->
        <button class="btn btn-outline-secondary me-3"
                id="prev-class-btn"
            @(currentIndex == 0 ? "disabled" : "")>
            ←
        </button>

        <!-- Название текущего класса -->
        <h3 class="m-0" id="current-class-name">
            @Model[currentIndex].ClassGroup.Name
        </h3>

        <!-- Правая стрелка -->
        <button class="btn @(currentIndex >= lastIndex ? "btn-outline-secondary" : "btn-outline-primary") ms-3"
                id="next-class-btn"
            @(currentIndex == lastIndex ? "disabled" : "")>
            →
        </button>
    </div>

    <button id="save-class-schedule-btn" class="btn btn-success mt-3" disabled>
        Сохранить расписание для класса
    </button>

    <!-- Частичное представление -->
    <div id="manual-partial-container">
        @for (int i = 0; i < Model.Count; i++)
        {
            <div id="partial-@i" class="manual-partial @(i == currentIndex ? "" : "d-none")">
                @await Html.PartialAsync("_WizardManualPartial", Model[i])
            </div>
        }
    </div>

</div>
<!-- МОДАЛЬНОЕ ОКНО ДЛЯ СОЗДАНИЯ УРОКА -->
<div class="modal fade" id="manualLessonModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Создание урока</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <form id="manual-lesson-form">

                    <!-- Класс (неактивный) -->
                    <div class="mb-3">
                        <label class="form-label">Класс</label>
                        <input type="text" class="form-control" id="modal-class-name" disabled />
                        <input type="hidden" id="modal-class-id" />
                    </div>

                    <!-- Предмет (неактивный) -->
                    <div class="mb-3">
                        <label class="form-label">Предмет</label>
                        <input type="text" class="form-control" id="modal-subject-name" disabled />
                        <input type="hidden" id="modal-subject-id" />
                    </div>

                    <!-- День и урок (неактивные) -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">День</label>
                            <input type="text" class="form-control" id="modal-day" disabled />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Урок</label>
                            <input type="text" class="form-control" id="modal-period" disabled />
                        </div>

                        <input type="hidden" id="modal-timeslot-id" />
                    </div>

                    <!-- Преподаватель -->
                    <div class="mb-3">
                        <label class="form-label">Преподаватель</label>
                        <select id="modal-teacher-select" class="form-select"></select>
                    </div>

                    <!-- Кабинет -->
                    <div class="mb-3">
                        <label class="form-label">Кабинет</label>
                        <select id="modal-room-select" class="form-select"></select>
                    </div>

                </form>

            </div>

            <div class="modal-footer">
                <button class="btn btn-primary" id="modal-save-btn">Сохранить</button>
            </div>

        </div>
    </div>
</div>

<div id="manualContextMenu" class="context-menu shadow">
    <div class="context-item" data-action="edit">Изменить</div>
    <div class="context-item" data-action="delete">Удалить</div>
</div>

@section Scripts {

    <script src="~/lib/select2/js/select2.min.js"></script>

    <!-- ========================================================= -->
    <!-- === 0. ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ ДЛЯ РАБОТЫ РУЧНОГО РАСПИСАНИЯ === -->
    <!-- ========================================================= -->

    <script>


        // Текущий индекс класса (переключение стрелками)
        let currentIndex = @currentIndex;
        const total = @Model.Count;

        // Глобальные модели (все классы)
        window.manualModels = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model));

        // Глобальное хранилище уроков по классам
        window.manualLessons = {}; // { classId: [ {lesson} ] }

        // История выбора преподавателей и кабинетов по классам
        let usedTeachers = {};   // { classId: Set<teacherId> }
        let usedRooms = {};      // { classId: Set<roomId> }

        // Перетаскиваемый предмет
        let draggedSubject = null;

        // Ячейка расписания, куда бросили предмет
        let currentCell = null;


        /* =========================================================
           === 1. ПЕРЕКЛЮЧЕНИЕ КЛАССОВ (СТРЕЛКИ) ===
           ========================================================= */

        function renderPartial() {

            // скрываем все частичные
            document.querySelectorAll(".manual-partial")
                .forEach(el => el.classList.add("d-none"));

            // показываем нужный
            document.getElementById("partial-" + currentIndex)
                .classList.remove("d-none");

            // обновляем название класса
            const classNames = window.manualModels.map(m => m.ClassGroup.Name);
            document.getElementById("current-class-name").innerText = classNames[currentIndex];

            updateArrows();
            updateSaveButtonState();
        }

        function updateArrows() {
            const prev = document.getElementById("prev-class-btn");
            const next = document.getElementById("next-class-btn");

            prev.disabled = currentIndex === 0;
            next.disabled = currentIndex === total - 1;

            prev.classList.toggle("btn-outline-secondary", currentIndex === 0);
            prev.classList.toggle("btn-outline-primary", currentIndex !== 0);

            next.classList.toggle("btn-outline-secondary", currentIndex === total - 1);
            next.classList.toggle("btn-outline-primary", currentIndex !== total - 1);
        }

        document.getElementById("prev-class-btn").addEventListener("click", () => {
            if (currentIndex > 0) {
                currentIndex--;
                renderPartial();
            }
        });

        document.getElementById("next-class-btn").addEventListener("click", () => {
            if (currentIndex < total - 1) {
                currentIndex++;
                renderPartial();
            }
        });

        /* =========================================================
           === 2. ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ДЛЯ ПОЛУЧЕНИЯ ДАННЫХ ===
           ========================================================= */

        function ensureHistory(classId) {
            if (!usedTeachers[classId]) usedTeachers[classId] = new Set();
            if (!usedRooms[classId]) usedRooms[classId] = new Set();
        }

        function getCurrentClassId() {
            return window.manualModels[currentIndex].ClassGroup.Id;
        }

        function getCurrentClassName() {
            return window.manualModels[currentIndex].ClassGroup.Name;
        }

        function getTeachersForClass(classId) {
            return window.manualModels[currentIndex].Teachers.map(t => ({
                userId: t.UserId,
                fio: t.User.GetFIO,
                subjectsCsv: t.Subjects.map(s => s.Id).join(","),
                subjectsString: t.SubjectsToString
            }));
        }

        function getRoomsForClass(classId) {
            return window.manualModels[currentIndex].Rooms.map(r => ({
                id: r.Id,
                roomNumber: r.RoomNumber,
                subjectsCsv: r.AssignedSubjects.map(s => s.Id).join(",")
            }));
        }


        /* =========================================================
           === 3. DRAG & DROP ПРЕДМЕТОВ ===
           ========================================================= */

        // Начало перетаскивания предмета
        document.addEventListener("dragstart", function(e) {
            const item = e.target.closest(".subject-item");
            if (!item) return;

            draggedSubject = {
                id: item.dataset.subjectId,
                name: item.dataset.subjectName,
                hours: parseInt(item.dataset.hours),
                element: item
            };

            e.dataTransfer.effectAllowed = "move";
        });

        // Разрешаем бросать в ячейки
        document.addEventListener("dragover", function(e) {
            const cell = e.target.closest(".schedule-cell");
            if (!cell) return;

            e.preventDefault();
            e.dataTransfer.dropEffect = "move";
        });

        // Бросили предмет в ячейку → открываем модалку
        document.addEventListener("drop", function(e) {
            const cell = e.target.closest(".schedule-cell");
            if (!cell || !draggedSubject) return;

            e.preventDefault();

            currentCell = cell;

            const classId = getCurrentClassId();
            const className = getCurrentClassName();

            const subjectId = draggedSubject.id;
            const subjectName = draggedSubject.name;

            const day = cell.dataset.day;
            const dayDisplay = cell.dataset.dayDisplay;

            const period = cell.dataset.period;
            const timeslotId = cell.dataset.timeslotId;

            const teachers = getTeachersForClass(classId);
            const rooms = getRoomsForClass(classId);

            openLessonModal(
                classId,
                className,
                subjectId,
                subjectName,
                day,
                dayDisplay,
                period,
                timeslotId,
                teachers,
                rooms
            );
        });


        /* =========================================================
           === 4. МОДАЛЬНОЕ ОКНО: ПОДСВЕТКА И СОРТИРОВКА ===
           ========================================================= */

        function formatTeacher(option) {
            if (!option.id) return option.text;

            const teacherId = option.id;
            const subjects = (option.element.dataset.subjects || "").split(",");
            const subjectId = $("#modal-subject-id").val();
            const classId = $("#modal-class-id").val();

            ensureHistory(classId);

            const isUsed = usedTeachers[classId].has(teacherId);
            const isProfile = subjects.includes(subjectId);

            let bg = "";

            if (isProfile && isUsed) {
                bg = "#d4f7d4"; // зелёный — профильный + ранее выбранный
            }
            else if (!isProfile) {
                bg = "#fff7d1"; // жёлтый — не профильный
            }
            // профильный, но не выбранный → белый (без заливки)

            return $('<span style="background:' + bg + '; padding:3px 6px; border-radius:4px;">' + option.text + '</span>');
        }

        function teacherSorter(data) {
            const subjectId = $("#modal-subject-id").val();
            const classId = $("#modal-class-id").val();

            ensureHistory(classId);

            return data.sort((a, b) => {
                const aId = a.id;
                const bId = b.id;

                const aSubjects = (a.element.dataset.subjects || "").split(",");
                const bSubjects = (b.element.dataset.subjects || "").split(",");

                const aUsed = usedTeachers[classId].has(aId);
                const bUsed = usedTeachers[classId].has(bId);

                const aProfile = aSubjects.includes(subjectId);
                const bProfile = bSubjects.includes(subjectId);

                // 1. Профильные + ранее выбранные
                if (aProfile && aUsed && !(bProfile && bUsed)) return -1;
                if (bProfile && bUsed && !(aProfile && aUsed)) return 1;

                // 2. Профильные
                if (aProfile && !bProfile) return -1;
                if (!aProfile && bProfile) return 1;

                // 3. Остальные
                return a.text.localeCompare(b.text);
            });
        }

        function formatRoom(option) {
            if (!option.id) return option.text;

            const roomId = option.id;
            const subjects = (option.element.dataset.subjects || "").split(",");
            const subjectId = $("#modal-subject-id").val();
            const classId = $("#modal-class-id").val();

            ensureHistory(classId);

            const isUsed = usedRooms[classId].has(roomId);
            const isProfile = subjects.includes(subjectId);

            let bg = "";

            if (isProfile && isUsed) {
                bg = "#d4f7d4"; // зелёный — профильный + ранее выбранный
            }
            else if (!isProfile) {
                bg = "#fff7d1"; // жёлтый — не профильный
            }
            // профильный, но не выбранный → белый

            return $('<span style="background:' + bg + '; padding:3px 6px; border-radius:4px;">' + option.text + '</span>');
        }

        function roomSorter(data) {
            const subjectId = $("#modal-subject-id").val();
            const classId = $("#modal-class-id").val();

            ensureHistory(classId);

            return data.sort((a, b) => {
                const aId = a.id;
                const bId = b.id;

                const aSubjects = (a.element.dataset.subjects || "").split(",");
                const bSubjects = (b.element.dataset.subjects || "").split(",");

                const aUsed = usedRooms[classId].has(aId);
                const bUsed = usedRooms[classId].has(bId);

                const aProfile = aSubjects.includes(subjectId);
                const bProfile = bSubjects.includes(subjectId);

                // 1. Профильные + ранее выбранные
                if (aProfile && aUsed && !(bProfile && bUsed)) return -1;
                if (bProfile && bUsed && !(aProfile && aUsed)) return 1;

                // 2. Профильные
                if (aProfile && !bProfile) return -1;
                if (!aProfile && bProfile) return 1;

                // 3. Остальные
                return a.text.localeCompare(b.text);
            });
        }

        /* =========================================================
           === 5. ОТКРЫТИЕ МОДАЛКИ ===
           ========================================================= */

        function openLessonModal(classId, className, subjectId, subjectName, day, dayDisplay, period, timeslotId, teachers, rooms) {

            ensureHistory(classId);

            $("#modal-class-id").val(classId);
            $("#modal-class-name").val(className);

            $("#modal-subject-id").val(subjectId);
            $("#modal-subject-name").val(subjectName);

            $("#modal-day").val(dayDisplay);
            $("#modal-period").val(period);
            $("#modal-timeslot-id").val(timeslotId);

            // ====== ПРЕПОДАВАТЕЛИ ======
            const teacherSelect = $("#modal-teacher-select");
            teacherSelect.empty();

            teachers.forEach(t => {
                teacherSelect.append(
                    `<option value="${t.userId}" data-subjects="${t.subjectsCsv}">
                                                            ${t.fio} (${t.subjectsString})
                                                        </option>`
                );
            });

            teacherSelect.select2({
                width: '100%',
                templateResult: formatTeacher,
                sorter: teacherSorter,
                dropdownParent: $('#manualLessonModal')
            });

            // ====== КАБИНЕТЫ ======
            const roomSelect = $("#modal-room-select");
            roomSelect.empty();

            rooms.forEach(r => {
                roomSelect.append(
                    `<option value="${r.id}" data-subjects="${r.subjectsCsv}">
                                                            ${r.roomNumber}
                                                        </option>`
                );
            });

            roomSelect.select2({
                width: '100%',
                templateResult: formatRoom,
                sorter: roomSorter,
                dropdownParent: $('#manualLessonModal')
            });

            // Открываем модалку
            const modal = new bootstrap.Modal(document.getElementById("manualLessonModal"));
            modal.show();
        }

        /* =========================================================
           === 6. СОХРАНЕНИЕ УРОКА И ОТРИСОВКА В ЯЧЕЙКЕ ===
           ========================================================= */

        document.getElementById("modal-save-btn").addEventListener("click", function() {
            if (window.editMode) {
    applyEditLesson();
    window.editMode = false;
    bootstrap.Modal.getInstance(document.getElementById("manualLessonModal")).hide();
    return;
}


            const classId = $("#modal-class-id").val();
            const subjectId = $("#modal-subject-id").val();
            const teacherId = $("#modal-teacher-select").val();
            const roomId = $("#modal-room-select").val();
            const timeslotId = $("#modal-timeslot-id").val();

            ensureHistory(classId);

            usedTeachers[classId].add(teacherId);
            usedRooms[classId].add(roomId);

            // сохраняем урок в глобальном списке
            if (!window.manualLessons[classId]) window.manualLessons[classId] = [];

            window.manualLessons[classId].push({
                classId,
                subjectId,
                teacherId,
                roomId,
                timeslotId
            });

            // отрисовываем в ячейке
            currentCell.querySelector(".cell-content").innerHTML = `
                                                    <div class="p-1 bg-light border rounded">
                                                        <strong>${$("#modal-subject-name").val()}</strong><br/>
                                                        <small>Преп.: ${$("#modal-teacher-select option:selected").text()}</small><br/>
                                                        <small>Каб.: ${$("#modal-room-select option:selected").text()}</small>
                                                    </div>
                                                        `;
            // === ДЕЛАЕМ ЯЧЕЙКУ НЕАКТИВНОЙ ===
            currentCell.classList.add("cell-filled");
            currentCell.classList.remove("dropzone");

            // запрещаем dragover/drop
            currentCell.addEventListener("dragover", e => e.preventDefault(), { capture: true });
            currentCell.addEventListener("drop", e => e.preventDefault(), { capture: true });

            // уменьшаем часы
            draggedSubject.hours -= 1;
            draggedSubject.element.dataset.hours = draggedSubject.hours;
            draggedSubject.element.querySelector(".badge").innerText = draggedSubject.hours;

            if (draggedSubject.hours <= 0) {
                draggedSubject.element.setAttribute("draggable", "false");
                draggedSubject.element.classList.add("disabled");
            }

            draggedSubject = null;

            updateSaveButtonState();

            bootstrap.Modal.getInstance(document.getElementById("manualLessonModal")).hide();
        });

        $(document).on('select2:open', function(e) {

            const selectId = e.target.id;

            // Сбрасываем выбранный элемент
            const select = $('#' + selectId);
            select.val(null).trigger('change.select2');

            // Прокручиваем вверх
            const dropdown = document.querySelector('.select2-container--open .select2-results__options');
            if (dropdown) dropdown.scrollTop = 0;
        });

        document.getElementById("save-class-schedule-btn").addEventListener("click", function() {

            const classId = getCurrentClassId();

            const lessons = window.manualLessons[classId] || [];

            if (lessons.length === 0) {
                alert("Для этого класса нет созданных уроков.");
                return;
            }

            // отправляем на сервер
            fetch('/ScheduleGenerator/SaveManualSchedule', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    classId: classId,
                    lessons: lessons
                })
            })
                .then(r => r.json())
                .then(result => {

                    if (result.success) {

                        // делаем расписание неактивным
                        disableClassSchedule(classId);

                        // переключаемся на следующий класс
                        if (currentIndex < total - 1) {
                            currentIndex++;
                            renderPartial();
                        }
                        else if (currentIndex > 0) {
                            currentIndex--;
                            renderPartial();
                        }
                        else {
                            alert("Все расписания успешно сохранены!");
                            window.location.href = "/Shedule/All";
                        }
                    }
                    else {
    if (result.conflicts) {
        let text = "Обнаружены конфликты:\n\n";

        for (const [type, list] of Object.entries(result.conflicts)) {
            if (!list || list.length === 0) continue;

            text += type + ":\n";
            list.forEach(msg => {
                text += "  - " + msg + "\n";
            });
            text += "\n";
        }

        alert(text);
    } else {
        alert("Ошибка: " + result.message);
    }
}
                });
        });
        function disableClassSchedule(classId) {

            // блокируем все ячейки
            document.querySelectorAll(`#partial-${currentIndex} .schedule-cell`)
                .forEach(cell => {
                    cell.classList.add("cell-disabled");
                    cell.removeAttribute("draggable");
                });

            // блокируем предметы
            document.querySelectorAll(`#partial-${currentIndex} .subject-item`)
                .forEach(item => {
                    item.classList.add("disabled");
                    item.setAttribute("draggable", "false");
                });

            // блокируем кнопку сохранения
            document.getElementById("save-class-schedule-btn").disabled = true;
        }
        function updateSaveButtonState() {
            const classId = getCurrentClassId();

            // все предметы слева
            const items = document.querySelectorAll(`#partial-${currentIndex} .subject-item`);

            let hasRemaining = false;

            items.forEach(item => {
                const count = parseInt(item.dataset.count || "0");
                if (count > 0) {
                    hasRemaining = true;
                }
            });

            const btn = document.getElementById("save-class-schedule-btn");

            if (hasRemaining) {
                btn.disabled = true;
                btn.classList.add("disabled");
            } else {
                btn.disabled = false;
                btn.classList.remove("disabled");
            }
        }
        const manualMenu = document.getElementById("manualContextMenu");
let contextCell = null;

document.addEventListener("contextmenu", function (e) {
    const cell = e.target.closest(".schedule-cell");
    if (!cell) return;

    // показываем меню только если ячейка заполнена
    if (!cell.classList.contains("cell-filled")) {
        return; // пустая ячейка → меню не показываем
    }

    e.preventDefault();
    contextCell = cell;

    manualMenu.style.top = e.pageY + "px";
    manualMenu.style.left = e.pageX + "px";
    manualMenu.style.display = "block";
});


document.addEventListener("click", () => manualMenu.style.display = "none");
manualMenu.addEventListener("click", function (e) {
    const item = e.target.closest(".context-item");
    if (!item || item.classList.contains("disabled") || !contextCell) return;

    const action = item.dataset.action;

    if (action === "edit") {
        openEditModal(contextCell);
    }

    if (action === "delete") {
        deleteLesson(contextCell);
    }
});
function openEditModal(cell) {

    const classId = getCurrentClassId();
    const timeslotId = cell.dataset.timeslotId;

    const lesson = window.manualLessons[classId].find(l => l.timeslotId == timeslotId);
    if (!lesson) return;

    $("#modal-class-id").val(lesson.classId);
    $("#modal-subject-id").val(lesson.subjectId);
    $("#modal-timeslot-id").val(lesson.timeslotId);

    $("#modal-subject-name").val(cell.querySelector("strong").innerText);

    $("#modal-teacher-select").val(lesson.teacherId).trigger("change");
    $("#modal-room-select").val(lesson.roomId).trigger("change");

    window.editMode = true;
    window.editTimeslotId = timeslotId;

    new bootstrap.Modal(document.getElementById("manualLessonModal")).show();
}

function deleteLesson(cell) {

    const classId = getCurrentClassId();
    const timeslotId = cell.dataset.timeslotId;

    const index = window.manualLessons[classId].findIndex(l => l.timeslotId == timeslotId);
    if (index === -1) return;

    const lesson = window.manualLessons[classId][index];

    const subjectId = lesson.subjectId;
    const teacherId = lesson.teacherId;
    const roomId = lesson.roomId;

    // 1. Удаляем урок из manualLessons
    window.manualLessons[classId].splice(index, 1);

    // 2. Освобождаем ячейку
    cell.classList.remove("cell-filled");
    cell.classList.add("dropzone");
    cell.querySelector(".cell-content").innerHTML = "";

    // 3. Возвращаем часы предмету
    const subjectItem = document.querySelector(`.subject-item[data-subject-id="${subjectId}"]`);
    if (subjectItem) {
        let hours = parseInt(subjectItem.dataset.hours);
        hours++;
        subjectItem.dataset.hours = hours;
        subjectItem.querySelector(".badge").innerText = hours;

        subjectItem.classList.remove("disabled");
        subjectItem.setAttribute("draggable", "true");
    }

    // 4. Проверяем, остались ли уроки с этим teacherId
    const teacherStillUsed = window.manualLessons[classId].some(l => l.teacherId == teacherId);
    if (!teacherStillUsed) {
        usedTeachers[classId].delete(teacherId);
    }

    // 5. Проверяем, остались ли уроки с этим roomId
    const roomStillUsed = window.manualLessons[classId].some(l => l.roomId == roomId);
    if (!roomStillUsed) {
        usedRooms[classId].delete(roomId);
    }

    // 6. Проверяем, остались ли уроки с этим subjectId
    const subjectStillUsed = window.manualLessons[classId].some(l => l.subjectId == subjectId);
    if (!subjectStillUsed) {
        // если у тебя есть usedSubjects — удаляем
        if (window.usedSubjects && window.usedSubjects[classId]) {
            window.usedSubjects[classId].delete(subjectId);
        }
    }

    updateSaveButtonState();
}

function applyEditLesson() {

    const classId = $("#modal-class-id").val();
    const subjectId = $("#modal-subject-id").val();
    const teacherId = $("#modal-teacher-select").val();
    const roomId = $("#modal-room-select").val();
    const timeslotId = window.editTimeslotId;

    const lesson = window.manualLessons[classId].find(l => l.timeslotId == timeslotId);

    // обновляем usedTeachers / usedRooms
    usedTeachers[classId].add(teacherId);
    usedRooms[classId].add(roomId);

    // обновляем lesson
    lesson.subjectId = subjectId;
    lesson.teacherId = teacherId;
    lesson.roomId = roomId;

    // обновляем DOM
    const cell = document.querySelector(`.schedule-cell[data-timeslot-id="${timeslotId}"]`);
    cell.querySelector(".cell-content").innerHTML = `
        <div class="p-1 bg-light border rounded">
            <strong>${$("#modal-subject-name").val()}</strong><br/>
            <small>Преп.: ${$("#modal-teacher-select option:selected").text()}</small><br/>
            <small>Каб.: ${$("#modal-room-select option:selected").text()}</small>
        </div>
    `;
}


