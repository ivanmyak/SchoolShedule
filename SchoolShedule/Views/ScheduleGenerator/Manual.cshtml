@model List<ManualGenerateViewModel>
@using SchoolShedule.Extensions

@{
    ViewData["Title"] = "Ручное составление расписания";

    int currentIndex = ViewBag.Index ?? 0;
    int lastIndex = Model.Count - 1;
}

<div class="container-fluid mt-4">

    <!-- Навигация между классами -->
    <div class="d-flex justify-content-center align-items-center mb-4">

        <!-- Левая стрелка -->
        <button class="btn btn-outline-secondary me-3"
                id="prev-class-btn"
            @(currentIndex == 0 ? "disabled" : "")>
            ←
        </button>

        <!-- Название текущего класса -->
        <h3 class="m-0" id="current-class-name">
            @Model[currentIndex].ClassGroup.Name
        </h3>

        <!-- Правая стрелка -->
        <button class="btn btn-outline-primary ms-3"
                id="next-class-btn"
            @(currentIndex == lastIndex ? "disabled" : "")>
            →
        </button>
    </div>

    <!-- Частичное представление -->
    <div id="manual-partial-container">
        @for (int i = 0; i < Model.Count; i++)
        {
            <div id="partial-@i" class="manual-partial @(i == currentIndex ? "" : "d-none")">
                @await Html.PartialAsync("_WizardManualPartial", Model[i])
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        let currentIndex = @currentIndex;
        const total = @Model.Count;

        // Локальное состояние уроков
        window.manualLessons = {}; // Dictionary<int, List<Lesson>>

        function renderPartial() {

            // скрываем все частичные
            document.querySelectorAll(".manual-partial")
                .forEach(el => el.classList.add("d-none"));

            // показываем нужный
            document.getElementById("partial-" + currentIndex)
                .classList.remove("d-none");

            // обновляем название класса
            const className = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Select(m => m.ClassGroup.Name).ToList()));

            document.getElementById("current-class-name").innerText = className[currentIndex];

            // обновляем состояние стрелок
            document.getElementById("prev-class-btn").disabled = currentIndex === 0;
            document.getElementById("next-class-btn").disabled = currentIndex === total - 1;

            updateArrows();
        }

        // Переключение классов
        document.getElementById("prev-class-btn").addEventListener("click", () => {
            if (currentIndex > 0) {
                currentIndex--;
                renderPartial();
            }
        });

        document.getElementById("next-class-btn").addEventListener("click", () => {
            if (currentIndex < total - 1) {
                currentIndex++;
                renderPartial();
            }
        });
        function updateArrows() {

            const prev = document.getElementById("prev-class-btn");
            const next = document.getElementById("next-class-btn");

            // ЛЕВАЯ СТРЕЛКА
            if (currentIndex === 0) {
                prev.disabled = true;
                prev.classList.remove("btn-outline-primary");
                prev.classList.add("btn-outline-secondary");
            } else {
                prev.disabled = false;
                prev.classList.remove("btn-outline-secondary");
                prev.classList.add("btn-outline-primary");
            }

            // ПРАВАЯ СТРЕЛКА
            if (currentIndex === total - 1) {
                next.disabled = true;
                next.classList.remove("btn-outline-primary");
                next.classList.add("btn-outline-secondary");
            } else {
                next.disabled = false;
                next.classList.remove("btn-outline-secondary");
                next.classList.add("btn-outline-primary");
            }
        }

    </script>
}
