@model SchoolShedule.Models.GeneratorWizardViewModel

@{
    ViewData["Title"] = "Мастер генерации — шаг 3";
}

<h2 class="mb-3">Шаг 3: выбор преподавателей</h2>

<form asp-action="WizardStep3Post" method="post">

    <input type="hidden" asp-for="TemplateId" />

    @foreach (var subjectId in Model.SelectedSubjectIds)
    {
        <div class="card mb-3">
            <div class="card-header">
                Предмет ID: @subjectId
            </div>
            <div class="card-body">
                <select name="SelectedTeachers[@subjectId]" multiple class="form-select">
                    @* TODO: подгрузить преподавателей по предмету *@
                    <option value="00000000-0000-0000-0000-000000000001">Иванов И.И.</option>
                    <option value="00000000-0000-0000-0000-000000000002">Петров П.П.</option>
                </select>
            </div>
        </div>
    }

    <button type="submit" class="btn btn-primary">Далее</button>
</form>
