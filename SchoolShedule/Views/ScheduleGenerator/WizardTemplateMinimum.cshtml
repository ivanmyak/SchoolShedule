@model GeneratorWizardViewModel

@{
    ViewData["Title"] = "Быстрая генерация расписания";
}

<h2 class="mb-4">Генерация расписания</h2>

<div class="mb-3">
    <label class="form-label">Период</label>
    <select asp-for="PeriodType"
            id="period"
            asp-items="Html.GetEnumSelectList<SchoolShedule.Enums.SchedulePeriodType>()"
            class="form-select"></select>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Предмет</th>
            @foreach (var c in Model.ClassGroups)
            {
                <th class="text-center">
                    <input type="checkbox"
                           name="SelectedIds"
                           class="class-select"
                           data-class-id="@c.Id" />

                    <div>@c.Name</div>
                </th>
            }
        </tr>
    </thead>

    <tbody>
        @foreach (var s in Model.Subjects)
        {
            <tr>
                <td>@s.Name</td>

                @foreach (var c in Model.ClassGroups)
                {
                    <td>
                        <input type="number"
                               class="form-control hours-input"
                               style="min-width:5em"
                               data-subject="@s.Id"
                               data-class="@c.Id"
                               value="@(Model.PreloadedHours.FirstOrDefault(x => x.ClassGroupId == c.Id && x.SubjectId == s.Id)?.Hours ?? 0)"
                               min="0" />
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <button class="btn btn-primary" id="btnSave">Сохранить шаблон</button>

    <div class="form-check form-check-inline ms-3">
        <input class="form-check-input" type="checkbox" id="manualModeCheckbox" checked>
        <label class="form-check-label" for="manualModeCheckbox">Ручная настройка</label>
    </div>

    <button class="btn btn-success ms-2 d-none" id="btnGenerate">Сгенерировать</button>
</div>

<!-- Модальное окно -->
<div class="modal fade" id="templateNameModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Имя шаблона</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <input type="text" id="templateNameInput" class="form-control" placeholder="Введите имя шаблона" />
                <div id="templateNameError" class="text-danger mt-2" style="display:none;"></div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary" id="templateNameConfirmBtn">OK</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.templateIdValue = @Model.TemplateId;
        window.originalTemplateName = @Json.Serialize(Model.TemplateName ?? "");
    </script>
    <script src="~/js/wizardminimumscript.js"></script>
}
