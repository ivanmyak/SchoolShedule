@model SchoolShedule.Models.GeneratorWizardViewModel

@{
    ViewData["Title"] = "Мастер генерации — шаг 2";
}

<h2 class="mb-3">Шаг 2: выбор предметов</h2>

<form asp-action="WizardStep2Post" method="post">

    <input type="hidden" asp-for="TemplateId" />

    <div class="mb-3">
        <label class="form-label">Предметы</label>
        <select asp-for="SelectedSubjectIds" multiple class="form-select">
            @* TODO: подгрузить реальные предметы *@
            <option value="1">Математика</option>
            <option value="2">Русский язык</option>
            <option value="3">Английский язык</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Далее</button>
</form>
