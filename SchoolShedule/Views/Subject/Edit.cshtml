@model Subject

@{
    ViewData["Title"] = "Edit Subject";
}
<h2 class="mb-4">Редактирование предмета</h2>

<form asp-action="Edit" method="post" class="border p-4 rounded shadow-sm bg-light">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>

    <button class="btn btn-primary">Сохранить</button>
    <a asp-action="All" class="btn btn-secondary">Обратно к списку</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
