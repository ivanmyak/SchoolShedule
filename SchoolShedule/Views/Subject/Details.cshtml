@model Subject

<h2 class="mb-4">Информация о предмете</h2>

<div class="card shadow-sm">
    <div class="card-body">

        <h4 class="card-title">@Model.Name</h4>
        <p class="text-muted">Код: @Model.Code</p>

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Редактировать</a>
        <a asp-action="All" class="btn btn-secondary">Назад</a>

    </div>
</div>
