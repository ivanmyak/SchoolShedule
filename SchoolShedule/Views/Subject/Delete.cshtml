@model Subject

@{
    ViewData["Title"] = "Delete Subject";
}
<h2 class="mb-4 text-danger">Удаление предмета</h2>

<div class="card shadow-sm border-danger">
    <div class="card-body">

        <h4 class="card-title text-danger">
            Вы уверены, что хотите удалить предмет?
        </h4>

        <dl class="row">
            <dt class="col-sm-3">Название</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Код</dt>
            <dd class="col-sm-9">@Model.Code</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />

            <button type="submit" class="btn btn-danger">Удалить</button>
            <a asp-action="All" class="btn btn-secondary">Обратно к списку</a>
        </form>

    </div>
</div>
