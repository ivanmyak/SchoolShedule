{

  "ConnectionStrings": {
    "PostgresDB": "Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_ADMIN_USER};Password=${DB_ADMIN_PASSWORD}",
    "MSSQLDB": "Server=(LocalDB)\\MSSQLLocalDB;AttachDbFilename=${MSSQL_DB_FILE_LOCATION};Database=${DB_NAME};Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "System": "Warning",
      "SchoolShedule": "Debug"
    }
  },

  "LoggingProviders": {
    "Console": true,
    "Admin": true,
    "Monitoring": true
  },

  "LogFiles": {
    "Root": "Data/Logs",
    "RetentionDays": 180
  }
}
